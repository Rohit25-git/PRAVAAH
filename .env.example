# ==============================================================================
# PRAVAAH — Production Environment Configuration Template
# Predictive Risk And Vulnerability Analysis for ATM Activity & Hotspots
# ==============================================================================

# 1. APPLICATION CORE
APP_NAME="PRAVAAH"
APP_VERSION="2.0.0"
ENVIRONMENT=production
DEBUG=False

# 2. PUBLIC DOMAIN & HTTPS SETTINGS (Caddy Ingress)
# Set your fully qualified domain name (e.g., pravaah.gov.in or your VPS IP)
PUBLIC_DOMAIN=pravaah.yourdomain.gov.in
ACME_EMAIL=security-officer@pravaah.gov.in

# 3. SECURITY & AUTHENTICATION (RBAC)
# Generate a strong 64-char key: python scripts/generate_secrets.py
JWT_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_KEY_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 4. DATABASE (PostgreSQL 15 + PostGIS 3.3)
POSTGRES_DB=pravaah
POSTGRES_USER=pravaah_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD_2026!
DATABASE_URL=postgresql://pravaah_admin:CHANGE_ME_STRONG_DATABASE_PASSWORD_2026!@db:5432/pravaah

# 5. GROQ CLOUD AI COPILOT ENGINE
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 6. ML RISK SCORING WEIGHTS (Normalized Sum = 1.0)
RISK_WEIGHT_COMPLAINTS=0.25
RISK_WEIGHT_ANOMALY=0.25
RISK_WEIGHT_GEO=0.20
RISK_WEIGHT_TEMPORAL=0.15
RISK_WEIGHT_NETWORK=0.15

# 7. ASGI RUNTIME OPTIMIZATION
UVICORN_WORKERS=4
