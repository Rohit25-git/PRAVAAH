# PRAVAAH Production Caddy Reverse Proxy & Automated HTTPS
# Replace with your public domain (e.g., pravaah.gov.in or your VPS public IP / domain)
{$PUBLIC_DOMAIN:localhost} {
    # Automatic TLS certificate generation & renewal via Let's Encrypt
    # Set ACME email in environment (e.g. ACME_EMAIL=admin@pravaah.gov.in)
    tls {$ACME_EMAIL:internal}

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
        -Server
    }

    # High-Performance Compression (Zstandard & Gzip)
    encode zstd gzip

    # Reverse proxy to frontend container (serves SPA and proxies /api, /ws)
    reverse_proxy frontend:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
